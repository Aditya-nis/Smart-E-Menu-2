{
  "version": 2,
  "build": {
    "command": "python collectstatic.py"
  },
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/staticfiles/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
